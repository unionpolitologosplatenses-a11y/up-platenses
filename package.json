{
  "name": "up-platenses",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "astro": "astro",
    "db:init": "wrangler d1 execute up_platenses --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute up_platenses --remote --file=./schema.sql",
    "deploy": "astro build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "@astrojs/cloudflare": "^11.2.0",
    "@astrojs/tailwind": "^5.1.2",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
    "@cloudflare/workers-types": "^4.20241004.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
