---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getEnv, type Institutional, type Note, type Edition } from '../lib/db';

const env = getEnv(Astro);

const institutional = await env.DB.prepare('SELECT * FROM institutional WHERE id = 1')
  .first<Institutional>();

const { results: notes } = await env.DB.prepare(
  `SELECT * FROM notes WHERE status = 'published' ORDER BY note_date DESC LIMIT 3`
).all<Note>();

const latestEdition = await env.DB.prepare(
  `SELECT * FROM editions WHERE status = 'published' ORDER BY year DESC, number DESC LIMIT 1`
).first<Edition>();

const activities = (institutional?.activities ?? '')
  .split('\n')
  .map((a) => a.trim())
  .filter(Boolean);
---
<Layout title="Inicio">
  <!-- Hero -->
  <section class="container-up pt-16 md:pt-24">
    <div class="up-rule mb-8"><span class="seg-1"></span><span class="seg-2"></span><span class="seg-3"></span></div>
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr] md:items-end">
      <div>
        <h1 class="text-4xl leading-[1.1] text-ink md:text-6xl">
          <span class="text-fucsia">Unión</span> de Politólogos <span class="text-esmeralda">Platenses</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink/70">
          {institutional?.home_intro ||
            'Un espacio de encuentro para quienes estudian y ejercen la Ciencia Política y las Relaciones Internacionales desde La Plata.'}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/la-union" class="btn-primary">Conocer la Unión</a>
          <a href="/revista" class="btn-secondary">Ver la revista</a>
        </div>
      </div>
      <div class="border-l-2 border-celeste/30 pl-6">
        <p class="text-2xl font-medium leading-snug text-celeste">
          {institutional?.home_tagline || 'Unir, Potenciar y Profesionalizar'}
        </p>
      </div>
    </div>
  </section>

  <!-- Actividades -->
  {activities.length > 0 && (
    <section class="container-up mt-24 md:mt-32">
      <h2 class="text-2xl text-ink md:text-3xl">Qué hacemos</h2>
      <div class="mt-8 grid gap-px overflow-hidden rounded-sm border border-ink/10 bg-ink/10 md:grid-cols-3">
        {activities.map((activity) => (
          <div class="bg-white p-7">
            <p class="text-sm leading-relaxed text-ink/75">{activity}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Últimas notas -->
  {notes.length > 0 && (
    <section class="container-up mt-24 md:mt-32">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl text-ink md:text-3xl">Últimas notas</h2>
        <a href="/notas" class="text-sm font-medium text-esmeralda hover:underline">Ver todas</a>
      </div>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {notes.map((note) => <NoteCard note={note} />)}
      </div>
    </section>
  )}

  <!-- Revista destacada -->
  {latestEdition && (
    <section class="container-up mt-24 mb-32 md:mt-32">
      <div class="grid items-center gap-10 rounded-sm bg-esmeralda px-8 py-12 text-white md:grid-cols-[1fr_auto] md:px-14">
        <div>
          <p class="text-sm font-medium text-celeste">Pensare Krítikos · Edición {latestEdition.number} — {latestEdition.year}</p>
          <h3 class="mt-3 text-2xl md:text-3xl">{latestEdition.title}</h3>
          {latestEdition.description && (
            <p class="mt-3 max-w-lg text-sm text-white/80">{latestEdition.description}</p>
          )}
        </div>
        <a href={`/revista/${latestEdition.id}`} class="inline-flex items-center justify-center rounded-sm bg-white px-6 py-3 text-sm font-medium text-esmeralda hover:bg-white/90">
          Leer edición
        </a>
      </div>
    </section>
  )}
</Layout>
