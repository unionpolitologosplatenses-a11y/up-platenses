---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getEnv } from '../../../lib/db';

const env = getEnv(Astro);
const error = Astro.url.searchParams.get('error');

const last = await env.DB.prepare(`SELECT number FROM editions ORDER BY number DESC LIMIT 1`).first<{ number: number }>();
const suggestedNumber = (last?.number ?? 0) + 1;
const suggestedYear = new Date().getFullYear();
---
<AdminLayout title="Nueva edición">
  <a href="/admin/revista" class="text-sm text-ink/50 hover:text-esmeralda">← Revista</a>
  <h1 class="mt-3 text-2xl font-semibold">Nueva edición</h1>

  {error && <p class="mt-4 rounded-sm bg-fucsia/10 px-4 py-2.5 text-sm text-fucsia">{error}</p>}

  <form method="POST" action="/api/editions/create" enctype="multipart/form-data" class="mt-8 space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="number" class="field-label">Número de edición</label>
        <input id="number" name="number" type="number" min="1" required class="field-input" value={suggestedNumber} />
      </div>
      <div>
        <label for="year" class="field-label">Año</label>
        <input id="year" name="year" type="number" required class="field-input" value={suggestedYear} />
      </div>
    </div>

    <div>
      <label for="title" class="field-label">Título</label>
      <input id="title" name="title" required class="field-input" />
    </div>

    <div>
      <label for="description" class="field-label">Descripción</label>
      <textarea id="description" name="description" rows="3" class="field-input"></textarea>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="cover" class="field-label">Portada (imagen)</label>
        <input id="cover" name="cover" type="file" accept="image/*" class="field-input" />
      </div>
      <div>
        <label for="pdf" class="field-label">Archivo PDF</label>
        <input id="pdf" name="pdf" type="file" accept="application/pdf" class="field-input" />
      </div>
    </div>

    <div>
      <label for="status" class="field-label">Estado</label>
      <select id="status" name="status" class="field-input">
        <option value="draft">Borrador</option>
        <option value="published">Publicada</option>
      </select>
    </div>

    <button type="submit" class="btn-primary">Guardar edición</button>
  </form>
</AdminLayout>
