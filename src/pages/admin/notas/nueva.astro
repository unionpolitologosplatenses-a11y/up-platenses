---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { NOTE_CATEGORIES } from '../../../lib/db';

const error = Astro.url.searchParams.get('error');
const today = new Date().toISOString().slice(0, 10);
---
<AdminLayout title="Nueva nota" richEditor>
  <a href="/admin/notas" class="text-sm text-ink/50 hover:text-esmeralda">← Notas</a>
  <h1 class="mt-3 text-2xl font-semibold">Nueva nota</h1>

  {error && <p class="mt-4 rounded-sm bg-fucsia/10 px-4 py-2.5 text-sm text-fucsia">{error}</p>}

  <form method="POST" action="/api/notes/create" enctype="multipart/form-data" class="mt-8 space-y-5">
    <div>
      <label for="title" class="field-label">Título</label>
      <input id="title" name="title" required class="field-input" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="author" class="field-label">Autor</label>
        <input id="author" name="author" class="field-input" />
      </div>
      <div>
        <label for="note_date" class="field-label">Fecha</label>
        <input id="note_date" name="note_date" type="date" value={today} required class="field-input" />
      </div>
    </div>

    <div>
      <label for="image" class="field-label">Imagen</label>
      <input id="image" name="image" type="file" accept="image/*" class="field-input" />
    </div>

    <div>
      <label for="category" class="field-label">Categoría</label>
      <select id="category" name="category" class="field-input">
        {NOTE_CATEGORIES.map((c) => (
          <option value={c.value} selected={c.value === 'otros'}>{c.label}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="excerpt" class="field-label">Copete (resumen breve)</label>
      <textarea id="excerpt" name="excerpt" rows="2" class="field-input"></textarea>
    </div>

    <div>
      <label class="field-label">Contenido</label>
      <div id="editor-container" class="min-h-[320px] rounded-sm bg-white"></div>
      <input type="hidden" id="content-input" name="content" required />
    </div>

    <div>
      <label for="status" class="field-label">Estado</label>
      <select id="status" name="status" class="field-input">
        <option value="draft">Borrador</option>
        <option value="published">Publicada</option>
      </select>
    </div>

    <button type="submit" class="btn-primary">Guardar nota</button>
  </form>

  <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var quill = new Quill('#editor-container', {
        theme: 'snow',
        placeholder: 'Escribí el contenido de la nota…',
        modules: {
          toolbar: [
            [{ header: [2, 3, false] }],
            ['bold', 'italic', 'underline'],
            [{ list: 'ordered' }, { list: 'bullet' }],
            ['blockquote', 'link'],
            ['clean'],
          ],
        },
      });
      var hiddenInput = document.getElementById('content-input');
      var form = hiddenInput.closest('form');
      form.addEventListener('submit', function (e) {
        hiddenInput.value = quill.root.innerHTML;
        if (quill.getText().trim().length === 0) {
          e.preventDefault();
          alert('El contenido de la nota no puede estar vacío.');
        }
      });
    });
  </script>
</AdminLayout>
