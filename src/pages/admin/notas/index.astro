---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getEnv, type Note } from '../../../lib/db';

const env = getEnv(Astro);
const { results: notes } = await env.DB.prepare(`SELECT * FROM notes ORDER BY note_date DESC`).all<Note>();
---
<AdminLayout title="Notas">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Notas</h1>
    <a href="/admin/notas/nueva" class="btn-primary">+ Nueva nota</a>
  </div>

  <div class="mt-8 divide-y divide-ink/10 rounded-sm border border-ink/10 bg-white">
    {notes.length === 0 && <p class="p-6 text-sm text-ink/50">No hay notas todavía.</p>}
    {notes.map((note) => (
      <div class="flex flex-wrap items-center justify-between gap-3 p-5">
        <div>
          <p class="font-medium text-ink">{note.title}</p>
          <p class="mt-0.5 text-xs text-ink/50">
            {note.note_date} · {note.author || 'Sin autor'} ·{' '}
            <span class:list={[note.status === 'published' ? 'text-esmeralda' : 'text-fucsia']}>
              {note.status === 'published' ? 'Publicada' : 'Borrador'}
            </span>
          </p>
        </div>
        <div class="flex gap-3 text-sm">
          <a href={`/admin/notas/${note.id}`} class="font-medium text-esmeralda hover:underline">Editar</a>
          <form method="POST" action={`/api/notes/${note.id}/delete`} onsubmit="return confirm('¿Eliminar esta nota?')">
            <button type="submit" class="font-medium text-fucsia hover:underline">Eliminar</button>
          </form>
        </div>
      </div>
    ))}
  </div>
</AdminLayout>
