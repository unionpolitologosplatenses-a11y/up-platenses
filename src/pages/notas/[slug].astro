---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getEnv, categoryStyle, type Note } from '../../lib/db';
import { fileUrl } from '../../lib/r2';

const env = getEnv(Astro);
const { slug } = Astro.params;

const note = await env.DB.prepare(
  `SELECT * FROM notes WHERE slug = ? AND status = 'published'`
).bind(slug).first<Note>();

if (!note) {
  return Astro.redirect('/notas');
}

const tag = categoryStyle(note.category);
const dateFmt = new Date(note.note_date).toLocaleDateString('es-AR', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const paragraphs = note.content.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
---
<Layout title={note.title} description={note.excerpt || note.title}>
  <article class="container-up pt-16 md:pt-24">
    <a href="/notas" class="text-sm font-medium text-ink/50 hover:text-esmeralda">← Notas</a>

    <div class="mt-6 max-w-2xl">
      <span class:list={['inline-block rounded-sm px-2 py-0.5 text-xs font-medium', tag.badge]}>{tag.label}</span>
      <p class="mt-3 text-xs text-ink/50">{dateFmt}{note.author && ` · ${note.author}`}</p>
      <h1 class="mt-2 text-3xl leading-tight text-ink md:text-4xl">{note.title}</h1>
    </div>

    {note.image_key && (
      <div class="mt-10 aspect-[16/9] w-full overflow-hidden bg-esmeralda-light">
        <img src={fileUrl(note.image_key)} alt={note.title} class="h-full w-full object-cover" />
      </div>
    )}

    <div class="mx-auto mt-10 max-w-prose pb-32">
      {paragraphs.map((p) => (
        <p class="mb-5 text-base leading-relaxed text-ink/80">{p}</p>
      ))}
    </div>
  </article>
</Layout>
