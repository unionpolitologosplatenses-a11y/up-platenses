---
import { fileUrl } from '../lib/r2';
import type { Note } from '../lib/db';

interface Props { note: Note }
const { note } = Astro.props;

const dateFmt = new Date(note.note_date).toLocaleDateString('es-AR', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---
<a href={`/notas/${note.slug}`} class="group block">
  <div class="aspect-[4/3] overflow-hidden bg-esmeralda-light">
    {note.image_key && (
      <img
        src={fileUrl(note.image_key)}
        alt={note.title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        loading="lazy"
      />
    )}
  </div>
  <p class="mt-4 text-xs text-ink/50">{dateFmt} {note.author && `· ${note.author}`}</p>
  <h3 class="mt-1.5 text-lg font-medium leading-snug text-ink group-hover:text-esmeralda">
    {note.title}
  </h3>
  {note.excerpt && <p class="mt-2 text-sm leading-relaxed text-ink/65">{note.excerpt}</p>}
</a>
