---
const year = new Date().getFullYear();
---
<footer class="mt-32 border-t border-ink/10 bg-esmeralda-light/40">
  <div class="container-up grid gap-10 py-14 md:grid-cols-3">
    <div>
      <img src="/logo-up.png" alt="Unión de Politólogos Platenses" class="h-8 w-auto" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink/70">
        Unión de Politólogos Platenses. Un espacio para unir, potenciar y
        profesionalizar la Ciencia Política y las Relaciones Internacionales
        desde La Plata.
      </p>
    </div>

    <div>
      <p class="mb-3 text-sm font-semibold text-ink">Navegación</p>
      <ul class="space-y-2 text-sm text-ink/70">
        <li><a href="/la-union" class="hover:text-esmeralda">La Unión</a></li>
        <li><a href="/notas" class="hover:text-esmeralda">Notas</a></li>
        <li><a href="/revista" class="hover:text-esmeralda">Revista</a></li>
        <li><a href="/contacto" class="hover:text-esmeralda">Contacto</a></li>
      </ul>
    </div>

    <div>
      <p class="mb-3 text-sm font-semibold text-ink">Contacto</p>
      <ul class="space-y-2 text-sm text-ink/70">
        <li><a href="mailto:contacto@upplatenses.org" class="hover:text-esmeralda">contacto@upplatenses.org</a></li>
        <li>La Plata, Buenos Aires, Argentina</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink/10 py-5">
    <p class="container-up text-xs text-ink/50">
      © {year} Unión de Politólogos Platenses. Todos los derechos reservados.
    </p>
  </div>
</footer>
