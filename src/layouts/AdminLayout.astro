---
import '../styles/global.css';

interface Props { title: string; richEditor?: boolean }
const { title, richEditor = false } = Astro.props;

const links = [
  { href: '/admin/dashboard', label: 'Panel' },
  { href: '/admin/notas', label: 'Notas' },
  { href: '/admin/revista', label: 'Revista' },
  { href: '/admin/institucional', label: 'Institucional' },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} · Admin UP</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    {richEditor && (
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" />
    )}
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink">
    <div class="flex min-h-screen">
      <aside class="hidden w-56 flex-shrink-0 border-r border-ink/10 bg-white p-6 md:block">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo-mark.png" alt="UP" class="h-7 w-auto" />
          <span class="text-sm font-semibold text-ink/70">Admin</span>
        </a>
        <nav class="mt-10 flex flex-col gap-1">
          {links.map((l) => (
            <a
              href={l.href}
              class:list={[
                'rounded-sm px-3 py-2 text-sm font-medium',
                current.startsWith(l.href) ? 'bg-esmeralda-light text-esmeralda' : 'text-ink/60 hover:bg-ink/5',
              ]}
            >
              {l.label}
            </a>
          ))}
        </nav>
        <form method="POST" action="/api/auth/logout" class="mt-auto pt-10">
          <button type="submit" class="text-sm text-ink/40 hover:text-fucsia">Cerrar sesión</button>
        </form>
      </aside>

      <main class="flex-1 px-6 py-10 md:px-12">
        <div class="mx-auto max-w-4xl">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
